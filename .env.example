# Receipt scanner AI keys. Priority: OpenRouter > OpenAI > Gemini.
# Server-only (no VITE_ prefix): read by api/extract.ts and never bundled into the browser.
# If none is set, the app falls back to a simulated parser.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Logta API server (npm run server, see docs/API.md) — same AI keys as above ---
# LOGTA_LLM_MODEL=           # optional model override (default gpt-4o-mini)
# ALLOWED_ORIGINS=https://logta-alpha.vercel.app,http://localhost:5173
# ADMIN_TOKEN=               # protects /api/admin/* (unset = localhost only)
# PORT=8787
# LOGTA_DB_PATH=data/logta.db
