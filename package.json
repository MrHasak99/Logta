{
  "name": "logta",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:import-snapshot": "tsx src/db/import-web-snapshot.ts",
    "demo:ingest": "tsx scripts/demo-ingest.ts",
    "test": "vitest run",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "demo:fresh": "npm run db:reset && npm run demo:ingest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
